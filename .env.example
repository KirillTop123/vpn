# --- Panel -------------------------------------------------------------------
# Domain pointing (A record) at the panel server; Caddy gets a TLS certificate for it automatically.
PANEL_DOMAIN=panel.example.com
PANEL_URL=https://panel.example.com
ADMIN_PASSWORD=change-this-strong-password
# Random string, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me

# --- Branding (shown in Happ and in the bot) ---------------------------------
BRAND_NAME=MyVPN
SUPPORT_URL=https://t.me/your_support_account
# Optional text shown at the top of the server list in Happ
ANNOUNCE=
# How often Happ refreshes the server list, hours
SUB_UPDATE_HOURS=6

# --- Telegram bot ------------------------------------------------------------
# Get it from @BotFather
BOT_TOKEN=
# Your Telegram user id(s), comma separated (get it from @userinfobot)
ADMIN_TG_IDS=
TRIAL_DAYS=3
REFERRAL_BONUS_DAYS=7
# days:price_in_stars, comma separated
PLANS=30:150,90:400,180:750,365:1400
